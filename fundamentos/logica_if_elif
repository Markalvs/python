# if / elif ...... / else
# se / se não se / se não

#o código sempre irá executar o primeiro bloco de código que for verdadeiro, e não irá executar os outros blocos de código. 

condicao1 = True
condicao2 = True
condicao3 = True


if condicao1:
    print('Este é o código do if')
elif condicao2:
    print('Este é o código do elif')
elif condicao3:
    print('Este é o código do elif')
else:
    print('Este é o código do else')

#Foi possível ter outro if, pois se trata de outro bloco de código, e não do mesmo bloco de código do if/elif/else.

if 10 == 10:
        print ('Outro if')

print(1)